{
  "name": "beauty-zone-landing",
  "private": true,
  "scripts": {
    "icons:build": "node scripts/build-sprite.mjs",
    "css:build": "sass scss/main.scss css/main.css --style=expanded",
    "css:watch": "sass scss/main.scss css/main.css --watch --style=expanded",
    "build": "npm run icons:build && npm run css:build",
    "dev": "npm run css:build && concurrently \"npm run css:watch\" \"live-server . --open=index.html --port=5500\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "live-server": "^1.2.2",
    "sass": "^1.89.2",
    "svgo": "^3.3.2"
  }
}
